# Normaliza los archivos de texto 
* text=auto

# Archivos de código fuente y configuración web
*.js     text eol=lf
*.jsx    text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.json   text eol=lf
*.css    text eol=lf
*.html   text eol=lf

# Archivos de scripts
*.sh     text eol=lf
*.ps1    text eol=lf
*.cmd    text eol=crlf
*.bat    text eol=crlf

# Archivos Markdown y texto
*.md     text eol=lf
*.txt    text eol=lf

# Archivos de configuración de Git y entorno
.env     text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Evita tratamiento de archivos binarios
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.zip    binary
